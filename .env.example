# Copy this file to .env and fill in real values for your machine.
# .env is git-ignored; .env.example is safe to commit.

# PostgreSQL connection string
DB_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/heuresup

# HTTP server
PORT=3000
NODE_ENV=development

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Auth rate limiting (optional - defaults shown)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_SIGNUP_MAX=20
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
